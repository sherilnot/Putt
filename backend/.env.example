PORT=5000
MONGO_URI=mongodb://localhost:27017/puttum_kadalayum
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Business timezone used for weekly cutoffs (default Australia/Sydney)
APP_TIMEZONE=Australia/Sydney
# Comma-separated browser origins allowed by CORS (required in production for web clients)
CORS_ORIGINS=http://localhost:8081
