{
  "expo": {
    "name": "Puttum Beefum",
    "slug": "puttum-beefum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "puttumbeefum",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.puttumbeefum.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8F0"
      },
      "package": "com.puttumbeefum.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F0",
          "imageWidth": 200
        }
      ]
    ]
  }
}
