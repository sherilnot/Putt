{
  "expo": {
    "name": "Puttum Kadalayum",
    "slug": "puttum-kadalayum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "puttumkadalayum",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.puttumbeefum.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#A8401F"
      },
      "package": "com.puttumbeefum.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F0E6",
          "imageWidth": 160
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "25393750-ff11-4c86-94b0-4fc201c4a897"
      }
    },
    "owner": "sheriluuu"
  }
}
